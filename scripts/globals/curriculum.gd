func subjects_for(grade: String) -> Array:
	var g = CURRICULUM.get(grade, {})
	return g.keys() if g is Dictionary else []

func topics_for(grade: String, subject: String) -> Array:
	var g = CURRICULUM.get(grade, {})
	if not (g is Dictionary):
		return []
	return g.get(subject, [])
